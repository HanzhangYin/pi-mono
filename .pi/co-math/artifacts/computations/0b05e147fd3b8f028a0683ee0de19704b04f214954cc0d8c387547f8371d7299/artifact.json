	"taskId": "research-plan-task-28",
	"summary": "Compute an exact Pieri presentation for the previously uncomputed beyond-reported-range rectangular case (r,q,i,j)=(5,6,2,2), and independently cross-check horizontal-strip enumeration. Certify each of the two 10-element proposed Schur families as a free basis of the finite indecomposable quotient by unit-pivot elimination restricted to its complementary columns.",
	"script": "from itertools import product\nfrom math import comb\nfrom hashlib import sha256\n\nr,q,i,j=5,6,2,2\nrho=(2,2)\n\ndef norm(x):\n    return tuple(a for a in x if a)\ndef deg(p): return sum(p)\ndef pad(p): return p+(0,)*(r-len(p))\ndef inside(p): return len(p)<=r and (not p or p[0]<=q)\ndef contains(p,mu):\n    P,M=pad(p),pad(mu)\n    return all(P[t]>=M[t] for t in range(r))\ndef parts_box(maxpart=q, maxlen=r):\n    # nonincreasing tuples, including empty\n    out=[]\n    def rec(last,left,a):\n        if a: out.append(tuple(a))\n        else: out.append(())\n        if len(a)==maxlen: return\n        for z in range(min(last,maxpart),0,-1):\n            rec(z,left-1,a+[z])\n    # avoid duplicate recursive inclusion structure: direct integer vectors\n    out=[]\n    def f(last,a):\n        out.append(tuple(a))\n        if len(a)<r:\n            for z in range(min(last,q),0,-1): f(z,a+[z])\n    f(q,[])\n    return sorted(set(out),key=lambda x:(deg(x),x))\n\nB=parts_box()\nU=[p for p in B if contains(p,rho)]\nidx={p:t for t,p in enumerate(U)}\nassert len(B)==comb(r+q,r)\n\n# Method 1: scan all outer partitions and use the interlacing criterion\n# nu/mu horizontal iff nu_i >= mu_i >= nu_{i+1} for all i.\ndef hs_scan(mu,k):\n    M=pad(mu); ans=[]\n    for nu in U:\n        N=pad(nu)\n        if deg(nu)-deg(mu)!=k: continue\n        if all(N[z]>=M[z] and M[z]>=N[z+1] for z in range(r-1)) and N[-1]>=M[-1]:\n            ans.append(nu)\n    return sorted(ans)\n\n# Method 2: enumerate row increments and check that no column receives two new boxes.\ndef hs_increment(mu,k):\n    M=pad(mu); ans=[]\n    def f(z,left,ds):\n        if z==r:\n            if left: return\n            N=tuple(M[t]+ds[t] for t in range(r))\n            if any(N[t]<N[t+1] for t in range(r-1)) or N[0]>q: return\n            # new intervals (M_t,N_t] must be pairwise disjoint\n            ints=[set(range(M[t]+1,N[t]+1)) for t in range(r)]\n            if any(ints[a]&ints[b] for a in range(r) for b in range(a)): return\n            nu=norm(N)\n            if nu in idx: ans.append(nu)\n            return\n        for d in range(left+1): f(z+1,left-d,ds+[d])\n    f(0,k,[])\n    return sorted(ans)\n\nrows=[]\nfor mu in U:\n    for k in range(1,q+1):\n        a=hs_scan(mu,k); b=hs_increment(mu,k)\n        assert a==b,(mu,k,a,b)\n        if a:\n            v={idx[nu]:1 for nu in a}\n            rows.append((mu,k,v))\n\n# Exact unit-pivot elimination.  For a prescribed free family F, only\n# complement columns may be pivots. Every operation is integral and unimodular.\ndef certify(free):\n    free={idx[p] for p in free}\n    active=[(mu,k,dict(v)) for mu,k,v in rows]\n    piv=[]\n    allowed=set(range(len(U)))-free\n    while allowed:\n        found=None\n        for z,(mu,k,v) in enumerate(active):\n            for c,a in v.items():\n                if c in allowed and abs(a)==1:\n                    found=(z,c,a);break\n            if found:break\n        if found is None:\n            raise AssertionError(('no unit pivot',len(allowed),len(active)))\n        z,c,a=found\n        mu,k,p=active.pop(z)\n        # normalize pivot to +1\n        if a==-1: p={x:-y for x,y in p.items()}\n        # eliminate c from every other relation\n        new=[]\n        for M,K,v in active:\n            t=v.get(c,0)\n            if t:\n                v=dict(v)\n                for x,y in p.items():\n                    v[x]=v.get(x,0)-t*y\n                    if v[x]==0: del v[x]\n            new.append((M,K,v))\n        active=new\n        piv.append((mu,k,U[c]))\n        allowed.remove(c)\n    residual=[(mu,k,v) for mu,k,v in active if v]\n    if residual: raise AssertionError(('residual relations on free columns',residual[:3],len(residual)))\n    # Pivot relations have coefficient +1 in distinct complement columns;\n    # they are a unimodular graph presentation over the selected free columns.\n    return piv\n\n# The two families from Theorem 5.4 for a=3,b=2.\nF1=[p for p in U if contains((5,5),p) and contains(p,rho)]\nF2=[p for p in U if contains((2,2,2,2,2),p) and contains(p,rho)]\nassert len(F1)==len(F2)==comb(5,2)==10\nP1=certify(F1)\nP2=certify(F2)\n\ndef ps(p): return '0' if not p else ''.join(map(str,p))\nrecord='\\n'.join([\n f'parameters={(r,q,i,j)} a=3 b=2',\n f'box_partitions={len(B)} U_rank={len(U)} pieri_rows={len(rows)}',\n 'F1='+','.join(map(ps,F1)),\n 'F2='+','.join(map(ps,F2)),\n 'P1='+ ';'.join(f'{ps(m)}:{k}->{ps(n)}' for m,k,n in P1),\n 'P2='+ ';'.join(f'{ps(m)}:{k}->{ps(n)}' for m,k,n in P2),\n])\nprint(record)\nprint('certificate_sha256='+sha256(record.encode()).hexdigest())\nprint('RESULT: both prescribed families have 10 elements and each complementary-column Pieri elimination has only unit pivots and no residual row; hence the computed presentation quotient is Z^10 on that family.')",
