	"summary": "Construct an exact, standalone Pieri-lattice certificate for (r,q,i,j)=(5,6,2,2): select unit pivots on the 421 complementary Schur columns, back-substitute transformed pivot relations to the ten prescribed F1 columns, and output exact integral reductions of all 2130 Pieri rows in the selected-row basis.",
	"script": "from itertools import combinations\nfrom collections import defaultdict\nimport json, hashlib\n\nr,q=5,6\nrect=(2,2)\nF=[(2,2),(3,2),(3,3),(4,2),(4,3),(5,2),(4,4),(5,3),(5,4),(5,5)]\n\ndef deg(p): return sum(p)\ndef pad(p,n=5): return p+(0,)*(n-len(p))\ndef contains(p,a):\n    P,A=pad(p),pad(a)\n    return all(P[i]>=A[i] for i in range(5))\ndef pname(p): return ''.join(map(str,p)) if p else '0'\ndef parts_box(maxdeg=None):\n    out=[]\n    def rec(prev,left,cur):\n        if len(cur)==r:\n            out.append(tuple(x for x in cur if x)); return\n        for x in range(min(prev,q,left),-1,-1): rec(x,left-x,cur+[x])\n    # enumerate by all weak rows directly, then degree order later\n    def rec2(prev,cur):\n        if len(cur)==r:\n            out.append(tuple(x for x in cur if x)); return\n        for x in range(min(prev,q),-1,-1): rec2(x,cur+[x])\n    out=[]; rec2(q,[])\n    return out\n\ndef hstrip(mu,nu):\n    M,N=pad(mu),pad(nu)\n    if any(N[i]<M[i] for i in range(r)): return False\n    # horizontal iff nu_{i+1} <= mu_i\n    return all(N[i+1]<=M[i] for i in range(r-1))\n\nallp=[p for p in parts_box() if contains(p,rect)]\ncols=sorted(allp,key=lambda p:(deg(p),p))\nci={p:i for i,p in enumerate(cols)}\nFidx=[ci[p] for p in F]\nassert len(cols)==431 and len(set(Fidx))==10\nbydeg=defaultdict(list)\nfor p in cols: bydeg[deg(p)].append(p)\nrows=[]\nfor mu in cols:\n    for k in range(1,q+1):\n        nus=[nu for nu in cols if deg(nu)==deg(mu)+k and hstrip(mu,nu)]\n        if nus:\n            rows.append((mu,k,tuple(nus)))\nrows.sort(key=lambda z:(deg(z[0])+z[1],z[1],z[0]))\nassert len(rows)==2130\nrows_bydeg=defaultdict(list)\nfor x in rows: rows_bydeg[deg(x[0])+x[1]].append(x)\n\n# Sparse integer row utilities; a relation is dict global-column -> coefficient.\ndef clean(d): return {k:v for k,v in d.items() if v}\ndef add_scaled(a,b,c):\n    # a += c*b\n    for k,v in b.items():\n        a[k]=a.get(k,0)+c*v\n        if not a[k]: del a[k]\n\ndef sparse_add(a,b,c):\n    z=dict(a); add_scaled(z,b,c); return z\n\nselected=[]\ntransformed=[]\nreductions={}\nblock_info=[]\nall_pivots=[]\n\nfor D in sorted(bydeg):\n    C=[ci[p] for p in bydeg[D] if ci[p] not in Fidx]\n    free=[ci[p] for p in bydeg[D] if ci[p] in Fidx]\n    cset=set(C)\n    piv=[] # entries (pivotcol, transformed sparse relation, transformed selected-row vector)\n    candidate_rows=rows_bydeg.get(D,[])\n    for row in candidate_rows:\n        cur={ci[x]:1 for x in row[2]}\n        # coefficient vector t: transformed cur = sum(t_j * selected_raw_j)\n        # initially raw current will become selected when chosen; for reduction of nonselected handled later\n        for pc,pr,pt in piv:\n            a=cur.get(pc,0)\n            if a:\n                add_scaled(cur,pr,-a)\n        choices=[c for c in C if c not in {z[0] for z in piv} and abs(cur.get(c,0))==1]\n        if choices:\n            # deterministic earliest complementary column\n            pc=choices[0]\n            sign=cur[pc]\n            if sign==-1: cur={x:-v for x,v in cur.items()}\n            # express this transformed pivot in selected raw rows: own raw minus preceding pivots\n            # reconstruct by replaying against original row\n            work={ci[x]:1 for x in row[2]}\n            t={}\n            for j,(oldpc,oldpr,oldpt) in enumerate(piv):\n                a=work.get(oldpc,0)\n                if a:\n                    add_scaled(work,oldpr,-a)\n                    for u,v in oldpt.items(): t[u]=t.get(u,0)-a*v\n            # now work equals sign*cur before sign; add own selected raw coordinate then normalize\n            own=len(selected)\n            t[own]=1\n            if sign==-1: t={u:-v for u,v in t.items()}\n            assert work==({x:sign*v for x,v in cur.items()})\n            selected.append(row)\n            piv.append((pc,cur,clean(t)))\n    if len(piv)!=len(C):\n        raise RuntimeError('unit pivot failure in degree %s: got %s expected %s'%(D,len(piv),len(C)))\n    # forward elimination of every row; record raw row as integral combination of selected rows\n    for row in candidate_rows:\n        cur={ci[x]:1 for x in row[2]}; coeff={}\n        for pc,pr,pt in piv:\n            a=cur.get(pc,0)\n            if a:\n                add_scaled(cur,pr,-a)\n                for u,v in pt.items(): coeff[u]=coeff.get(u,0)+a*v\n        if cur:\n            raise RuntimeError('residual relation degree %s row %s,%s: %s'%(D,pname(row[0]),row[1],cur))\n        reductions[(row[0],row[1])]=clean(coeff)\n    block_info.append((D,len(candidate_rows),len(C),len(free)))\n    all_pivots.extend(piv)\n\nassert len(selected)==421\nassert set((x[0],x[1]) for x in selected).issubset(set((x[0],x[1]) for x in rows))\n# Back-substitute pivot relations in reverse order within each degree, yielding c + F terms.\n# Since degrees separate, global reverse works because a relation has only same degree terms.\nreduced=[]\nfor pc,pr,pt in reversed(all_pivots):\n    z=dict(pr)\n    # eliminate later pivot columns using already finalized reduced relations\n    for epc,er,et in reduced:\n        a=z.get(epc,0)\n        if a: add_scaled(z,er,-a)\n    if z.get(pc)!=1: raise RuntimeError('lost pivot')\n    if any(c not in Fidx and c!=pc for c in z):\n        raise RuntimeError('not fully reduced')\n    reduced.append((pc,clean(z),pt))\nreduced=list(reversed(reduced))\n\n# Compact but complete certificate lines. Pivot relation uses transformed row after exact row operations,\n# then its reduced form. Each raw Pieri row is an integer combination of selected raw rows.\ndef relstr(d):\n    return ' + '.join((('' if v==1 else '-' if v==-1 else str(v)+'*')+pname(cols[c]) for c,v in sorted(d.items()))) or '0'\ndef vecstr(d):\n    return ','.join('%d:%d'%(u,v) for u,v in sorted(d.items())) or '0'\nlines=[]\nlines.append('CASE r=5 q=6 i=2 j=2')\nlines.append('columns=%d pieri_rows=%d selected=%d free=%s'%(len(cols),len(rows),len(selected),','.join(pname(x) for x in F)))\nlines.append('BLOCKS D:rows:complement:free='+';'.join('%d:%d:%d:%d'%x for x in block_info))\nlines.append('SELECTED_RAW index:mu:k:terms')\nfor z,(mu,k,nus) in enumerate(selected): lines.append('%d:%s:%d:%s'%(z,pname(mu),k,','.join(pname(x) for x in nus)))\nlines.append('REDUCED_PIVOT pivot:relation (equals zero; coefficient at pivot is 1)')\nfor pc,z,t in reduced: lines.append('%s:%s'%(pname(cols[pc]),relstr(z)))\nlines.append('ALL_PIERI_REDUCTIONS mu:k = sum(coeff[index]*SELECTED_RAW[index])')\nfor mu,k,nus in rows: lines.append('%s:%d=%s'%(pname(mu),k,vecstr(reductions[(mu,k)])))\nout='\\n'.join(lines)+'\\n'\nprint(out)\nprint('CERTIFICATE_SHA256='+hashlib.sha256(out.encode()).hexdigest())",
