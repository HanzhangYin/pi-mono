	"summary": "Compute the integral indecomposable quotient for (r,q,i,j)=(5,3,2,2), using separately coded horizontal-strip Pieri rows and brute-force Littlewood--Richardson tableau rows; fix degree-lexicographic partition/row orders, find unit-pivot complementary minors for both prescribed three-element families, and retain exact integral reductions of every Pieri and LR row.",
	"script": "from fractions import Fraction\nfrom itertools import product\nimport json, hashlib\n\n# Independent partition infrastructure: tuples in weakly decreasing order, with zero parts omitted.\ndef parts_box(r,q):\n    out=[]\n    def rec(last, left, cur):\n        out.append(tuple(x for x in cur if x))\n        if left:\n            for x in range(min(last,q),0,-1): rec(x,left-1,cur+[x])\n    # avoid duplicates from premature stopping: direct padded tuples\n    out=[]\n    def gen(pos,last,cur):\n        if pos==r:\n            out.append(tuple(x for x in cur if x)); return\n        for x in range(last,-1,-1): gen(pos+1,x,cur+[x])\n    gen(0,q,[])\n    return sorted(set(out), key=lambda p:(sum(p),p))\ndef size(p): return sum(p)\ndef contains(nu,mu):\n    return all((nu[k] if k<len(nu) else 0)>=(mu[k] if k<len(mu) else 0) for k in range(max(len(nu),len(mu))))\ndef fmt(p): return ''.join(map(str,p)) if p else '0'\ndef conj(p): return tuple(sum(x>=c for x in p) for c in range(1,(p[0] if p else 0)+1))\n\ndef horizontal(nu,mu):\n    cn,cm=conj(nu),conj(mu)\n    return all((cn[c] if c<len(cn) else 0)-(cm[c] if c<len(cm) else 0)<=1 for c in range(max(len(cn),len(cm))))\n\ndef pieri(mu,k,box):\n    # This routine is deliberately not used by the LR tableau code below.\n    return {nu:1 for nu in box if contains(nu,mu) and size(nu)==size(mu)+k and horizontal(nu,mu)}\n\ndef lr_coeff(alpha,mu,nu):\n    # Direct LR-tableau enumeration: fill nu/mu in row-reading order (right-to-left,\n    # top-to-bottom), enforce semistandard rows/columns and ballot prefixes.\n    if not contains(nu,mu) or size(nu)!=size(mu)+size(alpha): return 0\n    cells=[]\n    for rr in range(1,len(nu)+1):\n        m=mu[rr-1] if rr<=len(mu) else 0\n        for cc in range(nu[rr-1],m,-1): cells.append((rr,cc))\n    maxv=len(alpha); target={v+1:alpha[v] for v in range(maxv)}\n    used={v:0 for v in range(1,maxv+1)}; tab={}; ans=0\n    def go(k):\n        nonlocal ans\n        if k==len(cells): ans+=1; return\n        rr,cc=cells[k]\n        right=tab.get((rr,cc+1))\n        above=tab.get((rr-1,cc))\n        for v in range(1,maxv+1):\n            if used[v]>=target[v]: continue\n            if right is not None and v>right: continue  # entry <= right neighbour\n            if above is not None and v<=above: continue  # entry > upper neighbour\n            used[v]+=1\n            if all(used[z]>=used[z+1] for z in range(1,maxv)):\n                tab[(rr,cc)]=v; go(k+1); del tab[(rr,cc)]\n            used[v]-=1\n    go(0)\n    return ans\n\nr,q,i,j=5,3,2,2\nbox=parts_box(r,q)\nJ=[p for p in box if len(p)>=j and p[j-1]>=i]\ncol_index={p:k for k,p in enumerate(J)}\nF1=[(2,2),(3,2),(3,3)]\nF2=[(2,2),(2,2,1),(2,2,2)]\nassert all(p in J for p in F1+F2)\n\n# Fixed orders: columns and factors are (size, tuple); Pieri rows are (total degree,mu,k);\n# LR rows are (total degree,alpha,mu), all lexicographically ascending thereafter.\np_rows=[]\nfor mu in J:\n    for k in range(1,q+1):\n        d=pieri(mu,k,box)\n        if d:\n            v=[0]*len(J)\n            for nu,c in d.items(): v[col_index[nu]]=c\n            p_rows.append((size(mu)+k,('P',fmt(mu),k),v))\np_rows.sort(key=lambda z:(z[0],z[1][1],z[1][2]))\nlr_rows=[]\nfor alpha in box:\n    if not alpha: continue\n    for mu in J:\n        v=[0]*len(J)\n        for nu in J:\n            c=lr_coeff(alpha,mu,nu)\n            if c: v[col_index[nu]]=c\n        if any(v): lr_rows.append((size(alpha)+size(mu),('L',fmt(alpha),fmt(mu)),v))\nlr_rows.sort(key=lambda z:(z[0],z[1][1],z[1][2]))\n\ndef inverse_int(A):\n    n=len(A); M=[[Fraction(A[x][y]) for y in range(n)]+[Fraction(int(x==y)) for y in range(n)] for x in range(n)]\n    for c in range(n):\n        z=next((u for u in range(c,n) if M[u][c]),None)\n        if z is None: raise ValueError('singular')\n        M[c],M[z]=M[z],M[c]\n        piv=M[c][c]; M[c]=[x/piv for x in M[c]]\n        for u in range(n):\n            if u!=c and M[u][c]:\n                t=M[u][c]; M[u]=[M[u][v]-t*M[c][v] for v in range(2*n)]\n    inv=[[M[x][n+y] for y in range(n)] for x in range(n)]\n    assert all(z.denominator==1 for row in inv for z in row)\n    return [[int(z) for z in row] for row in inv]\ndef det_int(A):\n    n=len(A); M=[[Fraction(x) for x in row] for row in A]; d=Fraction(1)\n    for c in range(n):\n        z=next((u for u in range(c,n) if M[u][c]),None)\n        if z is None:return 0\n        if z!=c:M[c],M[z]=M[z],M[c];d=-d\n        p=M[c][c];d*=p\n        for u in range(c+1,n):\n            if M[u][c]:\n                t=M[u][c]/p\n                for v in range(c,n):M[u][v]-=t*M[c][v]\n    assert d.denominator==1\n    return int(d)\ndef choose(F):\n    C=[x for x,p in enumerate(J) if p not in F]\n    # unit-pivot selection separately by degree; mutated working rows retain labels.\n    chosen=[]\n    for deg in sorted(set(size(p) for p in J)):\n        cols=[x for x in C if size(J[x])==deg]\n        if not cols: continue\n        work=[]\n        for D,label,v in p_rows:\n            if D==deg: work.append([label,[v[x] for x in cols]])\n        rem=list(range(len(cols)))\n        while rem:\n            found=None\n            for a,(lab,w) in enumerate(work):\n                for c in rem:\n                    if abs(w[c])==1: found=(a,c);break\n                if found:break\n            if found is None: raise ValueError(('no unit pivot',deg,rem))\n            a,c=found; lab,w=work[a]; chosen.append((lab,deg,J[cols[c]],w[c]))\n            # clear pivot column of all other candidate rows; retain this row as pivot.\n            for b,(lab2,w2) in enumerate(work):\n                if b!=a and w2[c]:\n                    t=w2[c]//w[c]\n                    assert t*w[c]==w2[c]\n                    work[b]=[lab2,[w2[z]-t*w[z] for z in range(len(cols))]]\n            rem.remove(c)\n            work.pop(a)\n    # recover original selected rows by unique labels\n    bylab={lab:v for _,lab,v in p_rows}\n    S=[bylab[x[0]] for x in chosen]\n    U=[[v[c] for c in C] for v in S]\n    return C,chosen,S,U\n\ndef certify(F):\n    C,chosen,S,U=choose(F); det=det_int(U); inv=inverse_int(U)\n    def reduce(rows):\n        data=[]\n        for D,label,v in rows:\n            x=[v[c] for c in C]\n            z=[sum(x[t]*inv[t][u] for t in range(len(C))) for u in range(len(C))]\n            assert all(isinstance(a,int) for a in z)\n            rec=[sum(z[u]*S[u][c] for u in range(len(C))) for c in range(len(J))]\n            assert rec==v\n            data.append({'row':label,'coefficients_in_selected_row_order':z})\n        return data\n    pr=reduce(p_rows); lr=reduce(lr_rows)\n    return {'free_columns':[fmt(x) for x in F], 'complement_columns':[fmt(J[x]) for x in C],\n            'selected_pieri_rows':[{'row':a,'degree':d,'pivot_column':fmt(p),'pivot':pv} for a,d,p,pv in chosen],\n            'minor_determinant':det,'selected_row_order':[x[0] for x in chosen],\n            'pieri_reductions':pr,'lr_reductions':lr}\n\nout={'parameters':{'r':r,'q':q,'i':i,'j':j,'n':8,'s':5,'t':4,'v':'v_{5,5,4,8}','a':1,'b':2,'N':3},\n     'orders':{'partitions':'increasing (size, tuple); tuple is weakly decreasing row lengths','columns':'J partitions in that partition order','Pieri_rows':'increasing (total_degree, mu_string, k)','LR_rows':'increasing (total_degree, alpha_string, mu_string)'},\n     'counts':{'box_columns':len(box),'J_columns':len(J),'Pieri_rows':len(p_rows),'LR_rows':len(lr_rows)},\n     'F1':certify(F1),'F2':certify(F2)}\n# Keep all integer reduction vectors in artifact stdout; include integrity digest for the exact JSON payload.\npayload=json.dumps(out,sort_keys=True,separators=(',',':'))\nout['payload_sha256']=hashlib.sha256(payload.encode()).hexdigest()\nprint(json.dumps(out,sort_keys=True))",
