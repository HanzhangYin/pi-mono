	"summary": "For the p=c=3 interval lower=[2,2,0,0,0], upper=[5,5,5,5,5], compute complete Pieri matrices in degrees 4 through 10 and exhibit, relative to the vertical degreewise basis B_d={(2,2,lambda): lambda subseteq (2^3), |(2,2,lambda)|=d}, explicit row-selected unimodular minors on the complementary columns. Include the degree-4 empty witness.",
	"script": "import itertools, random\n\ndef norm(p):\n    return tuple(x for x in p if x)\ndef size(p): return sum(p)\ndef parts_box(total, lo, hi):\n    n=len(lo); out=[]\n    def rec(i, prev, cur, rem):\n        if i==n:\n            if rem==0: out.append(tuple(cur))\n            return\n        for x in range(min(prev,hi[i],rem),lo[i]-1,-1):\n            rec(i+1,x,cur+[x],rem-x)\n    rec(0,10**9,[],total)\n    return out\ndef horizontal(mu,nu):\n    # nu/mu is horizontal iff interlacing nu_i >= mu_i >= nu_{i+1}\n    n=len(mu)\n    return all(nu[i]>=mu[i] and (i==n-1 or mu[i]>=nu[i+1]) for i in range(n))\ndef det(A):\n    n=len(A)\n    if n==0:return 1\n    a=[r[:] for r in A]; sign=1; prev=1\n    for k in range(n-1):\n        q=next((i for i in range(k,n) if a[i][k]),None)\n        if q is None:return 0\n        if q!=k:a[k],a[q]=a[q],a[k];sign=-sign\n        pivot=a[k][k]\n        for i in range(k+1,n):\n            for j in range(k+1,n): a[i][j]=(a[i][j]*pivot-a[i][k]*a[k][j])//prev\n        prev=pivot\n        for i in range(k+1,n):a[i][k]=0\n    return sign*a[-1][-1]\nlo=(2,2,0,0,0); hi=(5,5,5,5,5)\n# B consists of (2,2,lambda), lambda in 2^3\nB={}\nfor d in range(4,11):\n    B[d]=set()\n    for lam in parts_box(d-4,(0,0,0),(2,2,2)):\n        B[d].add(norm((2,2)+lam))\nfor d in range(4,11):\n    cols=parts_box(d,lo,hi); C=[norm(x) for x in cols]\n    bidx=[i for i,x in enumerate(C) if x in B[d]]\n    comp=[i for i in range(len(C)) if i not in bidx]\n    rows=[]; labels=[]\n    for t in range(1,6):\n        if d-t<4: continue\n        for src in parts_box(d-t,lo,hi):\n            r=[1 if horizontal(src,nu) else 0 for nu in cols]\n            if any(r): rows.append(r); labels.append((t,norm(src)))\n    q=len(comp)\n    if q==0:\n        sel=[]; minor=[]; D=1\n    else:\n        # deterministic randomized search for an original-row minor of determinant +/-1\n        rng=random.Random(1000+d); inds=list(range(len(rows))); sel=None\n        for trial in range(200000):\n            if trial==0: cand=list(range(q))\n            else:\n                cand=rng.sample(inds,q)\n            A=[[rows[i][j] for j in comp] for i in cand]\n            D=det(A)\n            if abs(D)==1:\n                sel=cand; minor=A; break\n        if sel is None: raise RuntimeError('no unimodular minor found degree '+str(d))\n    print('DEGREE',d)\n    print('COLUMNS',C)\n    print('B_INDICES_1BASED',[i+1 for i in bidx],'B',[C[i] for i in bidx])\n    print('ROW_LABELS_1BASED',[(i+1,labels[i]) for i in range(len(rows))])\n    print('SELECTED_ROWS_1BASED',[i+1 for i in sel])\n    print('MINOR',minor)\n    print('DET',D)\n",
