{
	"attemptId": "research-attempt-research-plan-task-34-1",
	"taskId": "research-plan-task-34",
	"summary": "Independently test the first unverified boundary case (r,q,i,j)=(5,6,2,2) by a generic Littlewood--Richardson tableau enumerator and exact integral unit-pivot elimination of the resulting h_kJ relations, separately using each of the two proposed ten-element families as free columns.",
	"script": "from itertools import combinations\n\nr,q,i,j=5,6,2,2\n\ndef parts_box(r,q,minsize=0):\n    out=[]\n    def rec(prev, left, acc):\n        if left==0:\n            if sum(acc)>=minsize: out.append(tuple(x for x in acc if x))\n            return\n        for x in range(min(prev,q),-1,-1): rec(x,left-1,acc+[x])\n    rec(q,r,[])\n    return out\n\ndef contains(lam, rho):\n    return all((lam[t] if t<len(lam) else 0) >= x for t,x in enumerate(rho))\n\ndef lr_coeff(lam, mu, nu):\n    # Generic LR tableau recursion: rows read right-to-left, top-to-bottom.\n    if sum(lam)+sum(mu)!=sum(nu) or not contains(nu,lam): return 0\n    cells=[]\n    for a in range(len(nu)):\n        la=lam[a] if a<len(lam) else 0\n        cells += [(a,b) for b in range(nu[a]-1,la-1,-1)]\n    content=[0]+list(mu)\n    used=[0]*len(content)\n    filled={}\n    total=0\n    def go(pos):\n        nonlocal total\n        if pos==len(cells):\n            total+=1; return\n        a,b=cells[pos]\n        right=filled.get((a,b+1))\n        above=filled.get((a-1,b))\n        for x in range(1,len(content)):\n            if used[x]>=content[x]: continue\n            # Semistandard: entry <= right neighbor; entry > above neighbor.\n            if right is not None and x>right: continue\n            if above is not None and x<=above: continue\n            used[x]+=1\n            if all(used[z]>=used[z+1] for z in range(1,len(content)-1)):\n                filled[(a,b)]=x; go(pos+1); del filled[(a,b)]\n            used[x]-=1\n    go(0)\n    return total\n\nB=parts_box(r,q)\nJ=[x for x in B if contains(x,(i,)*j)]\nidx={x:k for k,x in enumerate(J)}\n# A_+J is generated by h_k s_mu, 1<=k<=q, because A_+=(h_1,...,h_q).\nrows=[]\nfor k in range(1,q+1):\n    lam=(k,)\n    for mu in J:\n        row={}\n        target=sum(lam)+sum(mu)\n        for nu in B:\n            if sum(nu)==target:\n                c=lr_coeff(lam,mu,nu)\n                if c: row[idx[nu]]=c\n        if row: rows.append(row)\n\nF1=[(2,2),(3,2),(3,3),(4,2),(4,3),(5,2),(4,4),(5,3),(5,4),(5,5)]\nF2=[(2,2),(2,2,1),(2,2,1,1),(2,2,2),(2,2,1,1,1),(2,2,2,1),(2,2,2,1,1),(2,2,2,2),(2,2,2,2,1),(2,2,2,2,2)]\n\ndef reduce_with_free(free_shapes):\n    free={idx[x] for x in free_shapes}\n    active=[dict(x) for x in rows]\n    pivots=[]\n    # Choose any unit coefficient in a nonfree column, clear that column globally.\n    while True:\n        choice=None\n        for a,row in enumerate(active):\n            for c,v in row.items():\n                if c not in free and abs(v)==1:\n                    choice=(a,c,v); break\n            if choice: break\n        if not choice: break\n        a,c,v=choice\n        pivot=active[a]\n        if v==-1: pivot={z:-w for z,w in pivot.items()}\n        new=[]\n        for b,row in enumerate(active):\n            if b==a: continue\n            w=row.get(c,0)\n            if w:\n                rr=dict(row)\n                for z,t in pivot.items():\n                    rr[z]=rr.get(z,0)-w*t\n                    if rr[z]==0: del rr[z]\n                row=rr\n            new.append(row)\n        active=new\n        pivots.append(c)\n    unresolved_nonfree=set()\n    residual_free=[]\n    for row in active:\n        for c in row:\n            if c not in free: unresolved_nonfree.add(c)\n        if row: residual_free.append(row)\n    return {\n        'pivots':len(pivots),\n        'distinct_pivots':len(set(pivots)),\n        'unresolved_nonfree':len(unresolved_nonfree),\n        'residual_rows':len(residual_free),\n        'residual_terms':sum(len(x) for x in residual_free),\n        'pivot_shapes':[J[c] for c in pivots],\n    }\n\nans1=reduce_with_free(F1)\nans2=reduce_with_free(F2)\nprint({'case':(r,q,i,j),'J_columns':len(J),'nonzero_hkJ_rows':len(rows),'F1_size':len(F1),'F2_size':len(F2),'F1':ans1,'F2':ans2})\nassert len(J)==431 and len(rows)==2130\nfor ans in (ans1,ans2):\n    assert ans['pivots']==421 and ans['distinct_pivots']==421\n    assert ans['unresolved_nonfree']==0 and ans['residual_rows']==0 and ans['residual_terms']==0\nprint('CERTIFIED: each quotient is freely based by its declared ten free columns under this exact LR-tableau relation computation.')",
