	"summary": "Fresh pure-Python finite verifier for (r,q,i,j)=(3,3,2,2): independently enumerates the ten box Schur columns, separate horizontal-strip Pieri and LR-tableau products (including zero pairs), computes Smith invariants without external libraries, and tests both three-element quotient bases. The task-35 certificate/digest is not supplied in the prompt, so the script records that comparison as unavailable rather than fabricating it.",
	"script": "import hashlib, json\nfrom math import comb\n\n# Fresh implementation: partitions are descending tuples with no zero parts.\ndef size(p): return sum(p)\ndef pad(p,n=3): return p+(0,)*(n-len(p))\ndef inside(p):\n    x=pad(p)\n    return len(p)<=3 and (not p or p[0]<=3) and all(x[t]>=x[t+1] for t in range(2))\ndef contains(a,b): # a contains b\n    A,B=pad(a),pad(b)\n    return all(A[t]>=B[t] for t in range(3))\ndef parts_box():\n    ans=[]\n    for a in range(3,-1,-1):\n        for b in range(a,-1,-1):\n            for c in range(b,-1,-1):\n                p=tuple(x for x in (a,b,c) if x)\n                ans.append(p)\n    return ans\ndef tag(p): return ''.join(map(str,p)) if p else '0'\nBOX=parts_box()\nJ=[p for p in BOX if contains(p,(2,2))]\nALL=[p for p in BOX if p]\nassert len(J)==10\ncol={p:k for k,p in enumerate(J)}\n\n# Direct horizontal-strip test, intentionally independent of LR tableaux.\ndef horizontal(mu,nu,k):\n    if not contains(nu,mu) or size(nu)-size(mu)!=k: return False\n    M,N=pad(mu),pad(nu)\n    # Added cells in a fixed column are N'_c-M'_c; horizontal iff <=1.\n    for c in range(1,4):\n        old=sum(x>=c for x in M); new=sum(x>=c for x in N)\n        if new-old>1: return False\n    return True\ndef pieri(mu,k):\n    return {nu:1 for nu in J if horizontal(mu,nu,k)}\n\n# Independent LR tableau enumerator: fill skew cells in row-reading order\n# (top-to-bottom, each row right-to-left), enforcing semistandard and lattice-word rules.\ndef lr(alpha,beta,nu):\n    if not (contains(nu,alpha) and size(alpha)+size(beta)==size(nu)): return 0\n    A,N=pad(alpha),pad(nu)\n    cells=[]\n    for r in range(3):\n        for c in range(N[r],A[r],-1): cells.append((r,c))\n    counts=list(beta); m=len(counts)\n    used=[0]*m; filling={}; total=0\n    def rec(t):\n        nonlocal total\n        if t==len(cells): total+=1; return\n        r,c=cells[t]\n        right=filling.get((r,c+1))\n        above=filling.get((r-1,c))\n        for v in range(1,m+1):\n            if used[v-1]>=counts[v-1]: continue\n            if right is not None and v>right: continue # rows weakly increasing left-to-right\n            if above is not None and v<=above: continue # columns strictly increasing downward\n            used[v-1]+=1\n            if all(used[z]>=used[z+1] for z in range(m-1)):\n                filling[(r,c)]=v; rec(t+1); del filling[(r,c)]\n            used[v-1]-=1\n    rec(0)\n    return total\ndef lrprod(alpha,beta):\n    return {nu:lr(alpha,beta,nu) for nu in J if lr(alpha,beta,nu)}\n\ndef row_from(d):\n    r=[0]*len(J)\n    for p,v in d.items(): r[col[p]]=v\n    return r\n\n# Exact integer Smith diagonal via elementary unimodular row/column operations.\ndef egcd_pos(a,b):\n    # a,b nonnegative, not both zero\n    old_r,r=a,b; old_s,s=1,0; old_t,t=0,1\n    while r:\n        q=old_r//r\n        old_r,r=r,old_r-q*r\n        old_s,s=s,old_s-q*s\n        old_t,t=t,old_t-q*t\n    return old_r,old_s,old_t\ndef xgcd(a,b):\n    g,x,y=egcd_pos(abs(a),abs(b))\n    return g, x*(1 if a>=0 else -1), y*(1 if b>=0 else -1)\ndef smith_diag(mat):\n    A=[list(map(int,row)) for row in mat]\n    m=len(A); n=len(A[0]) if m else 0; k=0\n    def swaprows(i,j): A[i],A[j]=A[j],A[i]\n    def swapcols(i,j):\n        for row in A: row[i],row[j]=row[j],row[i]\n    while k<m and k<n:\n        found=None\n        for i in range(k,m):\n            for j in range(k,n):\n                if A[i][j] and (found is None or abs(A[i][j])<abs(A[found[0]][found[1]])):\n                    found=(i,j)\n        if found is None: break\n        swaprows(k,found[0]); swapcols(k,found[1])\n        while True:\n            changed=False\n            # Euclidean reduction down pivot column.\n            for i in range(k+1,m):\n                b=A[i][k]\n                if not b: continue\n                a=A[k][k]\n                if b%a==0:\n                    q=b//a; A[i]=[A[i][z]-q*A[k][z] for z in range(n)]\n                else:\n                    g,u,v=xgcd(a,b); R,S=A[k][:],A[i][:]\n                    A[k]=[u*R[z]+v*S[z] for z in range(n)]\n                    A[i]=[(-b//g)*R[z]+(a//g)*S[z] for z in range(n)]\n                changed=True; break\n            if changed: continue\n            # Euclidean reduction across pivot row.\n            for j in range(k+1,n):\n                b=A[k][j]\n                if not b: continue\n                a=A[k][k]\n                if b%a==0:\n                    q=b//a\n                    for i in range(m): A[i][j]-=q*A[i][k]\n                else:\n                    g,u,v=xgcd(a,b)\n                    C=[A[i][k] for i in range(m)]; D=[A[i][j] for i in range(m)]\n                    for i in range(m):\n                        A[i][k]=u*C[i]+v*D[i]\n                        A[i][j]=(-b//g)*C[i]+(a//g)*D[i]\n                changed=True; break\n            if changed: continue\n            # If pivot fails to divide an interior entry, inject it into row k.\n            bad=None\n            a=A[k][k]\n            for i in range(k+1,m):\n                for j in range(k+1,n):\n                    if A[i][j]%a: bad=(i,j); break\n                if bad: break\n            if bad:\n                i,j=bad\n                A[k]=[A[k][z]+A[i][z] for z in range(n)]\n                changed=True; continue\n            break\n        if A[k][k]<0: A[k]=[-x for x in A[k]]\n        k+=1\n    return [A[i][i] for i in range(min(m,n)) if A[i][i]!=0]\n\np_pairs=[]; P=[]\nfor mu in J:\n    for k in (1,2,3):\n        d=pieri(mu,k); p_pairs.append((tag(mu),k,d)); P.append(row_from(d))\nl_pairs=[]; L=[]\nfor alpha in ALL:\n    for mu in J:\n        d=lrprod(alpha,mu); l_pairs.append((tag(alpha),tag(mu),d)); L.append(row_from(d))\n\nF1=[(2,2),(3,2),(3,3)]\nF2=[(2,2),(2,2,1),(2,2,2)]\nassert all(x in col for x in F1+F2)\ndef basis_test(M,F):\n    C=[z for z,p in enumerate(J) if p not in F]\n    projected=[[row[z] for z in C] for row in M]\n    return C,smith_diag(projected)\nsp=smith_diag(P); sl=smith_diag(L)\nchecks={}\nfor name,F in [('F1',F1),('F2',F2)]:\n    cp,dp=basis_test(P,F); cl,dl=basis_test(L,F)\n    checks[name]={'members':[tag(x) for x in F], 'pieri_complement':[tag(J[z]) for z in cp],\n                  'pieri_projected_smith':dp,'lr_complement':[tag(J[z]) for z in cl], 'lr_projected_smith':dl}\n\ndef nz_p(x): return {'mu':x[0],'k':x[1],'terms':{tag(p):v for p,v in x[2].items()}}\ndef nz_l(x): return {'alpha':x[0],'mu':x[1],'terms':{tag(p):v for p,v in x[2].items()}}\nout={'parameters':[3,3,2,2],'column_order':[tag(p) for p in J],\n     'pieri_nonzero':[nz_p(x) for x in p_pairs if x[2]],\n     'pieri_zero_pairs':[{'mu':x[0],'k':x[1]} for x in p_pairs if not x[2]],\n     'lr_nonzero':[nz_l(x) for x in l_pairs if x[2]],\n     'lr_zero_pairs':[{'alpha':x[0],'mu':x[1]} for x in l_pairs if not x[2]],\n     'pieri_rows':len(P),'lr_rows':len(L),'pieri_smith_nonzero':sp,'lr_smith_nonzero':sl,\n     'quotient_tests':checks}\n# Digests of this fresh fixed order and matrices; no task-35 certificate bytes were supplied.\nout['fresh_order_digest']=hashlib.sha256(json.dumps(out['column_order'],separators=(',',':')).encode()).hexdigest()\nout['fresh_pieri_matrix_digest']=hashlib.sha256(json.dumps(P,separators=(',',':')).encode()).hexdigest()\nout['fresh_lr_matrix_digest']=hashlib.sha256(json.dumps(L,separators=(',',':')).encode()).hexdigest()\nout['task35_certificate_comparison']='UNAVAILABLE: no durable task-35 certificate or its fixed-order/digest fields was supplied to this sandbox action.'\n# Assertions establish only this finite instance.\nassert sp==[1]*7 and sl==[1]*7\nfor z in checks.values(): assert z['pieri_projected_smith']==[1]*7 and z['lr_projected_smith']==[1]*7\nprint(json.dumps(out,sort_keys=True,indent=2))",
